<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/mtpcbridge/db" VERSION="2026090902" COMMENT="XMLDB file for local_mtpcbridge">
  <TABLES>
    <TABLE NAME="local_mtpcbridge_zalo" COMMENT="Zalo delivery state for Moodle course notifications">
